{
  "TemplateName": "remind-me-tech",
  "TemplateContent": {
    "Subject": "› daily.briefing({{subjectDate}})",
    "Html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head><body style=\"margin:0;padding:0;background:#010409;font-family:'SFMono-Regular',ui-monospace,'Cascadia Code',Consolas,Menlo,monospace;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:28px 16px;background:#010409;background-image:radial-gradient(circle at 50% -20%, #0d1b2e 0%, #010409 60%);\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:640px;background:#0d1117;border:1px solid #30363d;border-radius:14px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.6);\"><tr><td style=\"background:#161b22;padding:13px 18px;border-bottom:1px solid #21262d;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"width:70px;\"><span style=\"display:inline-block;width:12px;height:12px;border-radius:50%;background:#ff5f56;margin-right:8px;\"></span><span style=\"display:inline-block;width:12px;height:12px;border-radius:50%;background:#ffbd2e;margin-right:8px;\"></span><span style=\"display:inline-block;width:12px;height:12px;border-radius:50%;background:#27c93f;\"></span></td><td align=\"center\" style=\"color:#6e7681;font-size:12px;letter-spacing:0.5px;\">~/daily-briefing</td><td style=\"width:70px;\"></td></tr></table></td></tr><tr><td style=\"padding:26px 26px 8px;\"><div style=\"font-size:13px;color:#7ee787;line-height:1.8;\"><span style=\"color:#ff7b72;\">const</span> <span style=\"color:#79c0ff;\">today</span> <span style=\"color:#ff7b72;\">=</span> <span style=\"color:#a5d6ff;\">'{{today}}'</span>;</div><h1 style=\"margin:14px 0 4px;font-size:26px;font-weight:700;color:#e6edf3;letter-spacing:-0.5px;\">Good morning <span style=\"color:#58a6ff;\">world</span> <span style=\"color:#3fb950;\">✓</span></h1><p style=\"margin:0 0 8px;color:#6e7681;font-size:12px;\">// your briefing compiled successfully</p></td></tr><tr><td style=\"padding:14px 26px 4px;\"><div style=\"display:inline-block;background:#1f6feb1a;border:1px solid #1f6feb55;color:#79c0ff;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:20px;\">◆ Schedule</div></td></tr><tr><td style=\"padding:10px 26px 8px;\">{{#each events}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:8px;background:#161b22;border:1px solid #21262d;border-left:3px solid #58a6ff;border-radius:8px;\"><tr><td style=\"padding:12px 16px;\"><div style=\"color:#e6edf3;font-size:15px;font-weight:600;\">{{summary}}</div><div style=\"color:#8b949e;font-size:12px;margin-top:4px;\"><span style=\"color:#d2a8ff;\">{{dateLabel}}</span> <span style=\"color:#6e7681;\">·</span> <span style=\"color:#7ee787;\">{{timeLabel}}</span></div></td></tr></table>{{/each}}{{#unless events}}<div style=\"color:#6e7681;font-size:13px;padding:6px 2px;\">$ echo &quot;no events&quot; <span style=\"color:#3fb950;\"># free time ✦</span></div>{{/unless}}</td></tr><tr><td style=\"padding:16px 26px 4px;\"><div style=\"display:inline-block;background:#f778ba1a;border:1px solid #f778ba55;color:#f778ba;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:20px;\">◆ Tasks</div></td></tr><tr><td style=\"padding:10px 26px 24px;\">{{#each todos}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:8px;background:#161b22;border:1px solid #21262d;border-radius:8px;\"><tr><td style=\"padding:12px 16px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:top;width:24px;color:#3fb950;font-size:14px;font-weight:700;\">[ ]</td><td><div style=\"color:#e6edf3;font-size:15px;font-weight:600;\">{{icon}} {{task}}</div><div style=\"margin-top:6px;\"><span style=\"display:inline-block;background:#30363d;color:#79c0ff;font-size:11px;padding:2px 9px;border-radius:5px;margin-right:6px;\">#{{categoryLabel}}</span><span style=\"display:inline-block;color:#d29922;font-size:11px;\">{{statusLabel}}</span>{{#if dueLabel}}<span style=\"color:#6e7681;font-size:11px;\"> · due {{dueLabel}}</span>{{/if}}</div></td></tr></table></td></tr></table>{{/each}}{{#unless todos}}<div style=\"color:#6e7681;font-size:13px;padding:6px 2px;\">$ tasks --pending <span style=\"color:#3fb950;\"># all clear ✓</span></div>{{/unless}}</td></tr><tr><td style=\"padding:14px 26px;border-top:1px solid #21262d;background:#0b0f14;\"><span style=\"color:#3fb950;\">➜</span> <span style=\"color:#58a6ff;\">~</span> <span style=\"color:#6e7681;font-size:12px;\">keep shipping</span> <span style=\"display:inline-block;width:8px;height:15px;background:#7ee787;vertical-align:middle;\"></span></td></tr></table></td></tr></table></body></html>"
  }
}
