{
  "TemplateName": "remind-me-tech",
  "TemplateContent": {
    "Subject": "› daily.briefing({{subjectDate}})",
    "Html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>@media only screen and (max-width:600px){.op{padding:14px 8px !important;}.bp-pad{padding:20px !important;}.bp-h1{font-size:22px !important;}}</style></head><body style=\"margin:0;padding:0;background:#e2e8f0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" class=\"op\" style=\"padding:28px 16px;background:#e2e8f0;\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"max-width:660px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 40px rgba(2,6,23,0.12);\"><tr><td style=\"background:#0f766e;padding:20px 28px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"><tr><td style=\"color:#99f6e4;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;\">Daily Boarding Pass · 今日登机牌</td><td align=\"right\" style=\"color:#5eead4;font-size:12px;font-weight:600;\">✈ MORNING</td></tr></table><h1 class=\"bp-h1\" style=\"margin:12px 0 0;color:#ffffff;font-size:26px;font-weight:800;letter-spacing:-0.4px;\">Good morning ☀️</h1><p style=\"margin:6px 0 0;color:#ccfbf1;font-size:13px;\">{{today}}</p></td></tr><tr><td class=\"bp-pad\" style=\"padding:24px 28px 20px;background:#f8fafc;border-bottom:1px dashed #cbd5e1;\"><p style=\"margin:0 0 12px;font-size:11px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#a21caf;\">Manifest · 待办</p>{{#each todos}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin-bottom:12px;\"><tr><td style=\"width:20px;vertical-align:top;font-size:14px;color:#0f766e;font-weight:800;\">☐</td><td><div style=\"font-size:14px;font-weight:600;color:#0f172a;line-height:1.35;\">{{icon}} {{task}}</div><div style=\"margin-top:5px;\"><span style=\"display:inline-block;background:{{categoryBg}};color:{{categoryText}};font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;\">{{categoryLabel}}</span><span style=\"display:inline-block;background:{{statusBg}};color:{{statusText}};font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;margin-left:4px;\">{{statusLabel}}</span></div>{{#if dueLabel}}<div style=\"margin-top:4px;font-size:11px;color:#94a3b8;\">due {{dueLabel}}</div>{{/if}}</td></tr></table>{{/each}}{{#unless todos}}<p style=\"margin:0;font-size:13px;color:#94a3b8;\">所有任务已完成 ✅</p>{{/unless}}</td></tr><tr><td class=\"bp-pad\" style=\"padding:24px 28px;\"><p style=\"margin:0 0 12px;font-size:11px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#0f766e;\">Departures · 接下来的日程</p>{{#each events}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin-bottom:12px;\"><tr><td style=\"width:70px;vertical-align:top;padding-top:2px;\"><div style=\"font-size:15px;font-weight:800;color:#0f172a;font-variant-numeric:tabular-nums;\">{{timeLabel}}</div></td><td style=\"border-left:2px solid #99f6e4;padding-left:14px;\"><div style=\"font-size:15px;font-weight:700;color:#0f172a;line-height:1.35;\">{{summary}}</div><div style=\"margin-top:3px;font-size:12px;color:#64748b;\">{{dateLabel}}</div></td></tr></table>{{/each}}{{#unless events}}<p style=\"margin:0;font-size:14px;color:#94a3b8;\">最近没有活动 — clear skies ahead 🎉</p>{{/unless}}</td></tr><tr><td style=\"border-top:1px dashed #cbd5e1;background:#0f766e;padding:16px 28px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"><tr><td><div style=\"height:26px;background-image:repeating-linear-gradient(90deg,#ccfbf1 0,#ccfbf1 2px,transparent 2px,transparent 5px);border-radius:2px;\"></div></td><td align=\"right\" style=\"width:180px;padding-left:20px;color:#99f6e4;font-size:11px;letter-spacing:1px;\">SEAT 1A · GATE ☀ · 元气满满</td></tr></table></td></tr></table></td></tr></table></body></html>"
  }
}