{
  "TemplateName": "remind-me-digest",
  "TemplateContent": {
    "Subject": "📮 Daily digest — {{subjectDate}}",
    "Html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head><body style=\"margin:0;padding:0;background:#f5f3ef;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:24px;background:#f5f3ef;\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#ffffff;border:1px solid #ece9e3;border-radius:14px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.05);\"><tr><td style=\"padding:28px 30px 22px;\"><p style=\"margin:0;font-size:13px;color:#f59e0b;font-weight:700;letter-spacing:0.5px;\">DAILY DIGEST</p><h1 style=\"margin:6px 0 2px;font-size:26px;font-weight:800;color:#1c1917;letter-spacing:-0.5px;\">Good morning ☀️</h1><p style=\"margin:0;font-size:14px;color:#78716c;\">{{today}}</p></td></tr><tr><td style=\"padding:0 30px 20px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#faf9f7;border:1px solid #f0ede7;border-radius:10px;\"><tr><td style=\"padding:14px 20px;text-align:center;border-right:1px solid #f0ede7;\"><div style=\"font-size:24px;font-weight:800;color:#0ea5e9;\">{{eventCount}}</div><div style=\"font-size:11px;color:#a8a29e;text-transform:uppercase;letter-spacing:1px;font-weight:600;\">Events</div></td><td style=\"padding:14px 20px;text-align:center;\"><div style=\"font-size:24px;font-weight:800;color:#d946ef;\">{{todoCount}}</div><div style=\"font-size:11px;color:#a8a29e;text-transform:uppercase;letter-spacing:1px;font-weight:600;\">Tasks</div></td></tr></table></td></tr><tr><td style=\"padding:0 30px 8px;\"><p style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#0ea5e9;\">On the schedule</p></td></tr><tr><td style=\"padding:8px 30px 4px;\">{{#each events}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:10px;\"><tr><td style=\"width:4px;background:#0ea5e9;border-radius:4px 0 0 4px;\"></td><td style=\"padding:12px 16px;background:#f8fafc;border:1px solid #eef2f7;border-left:none;border-radius:0 10px 10px 0;\"><div style=\"font-size:15px;font-weight:600;color:#1c1917;\">{{summary}}</div><div style=\"margin-top:3px;font-size:13px;color:#78716c;\">{{dateLabel}} · {{timeLabel}}</div></td></tr></table>{{/each}}{{#unless events}}<p style=\"margin:2px 0 10px;font-size:14px;color:#a8a29e;\">Nothing on the calendar — a clear runway ahead. 🎉</p>{{/unless}}</td></tr><tr><td style=\"padding:12px 30px 8px;\"><p style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#d946ef;\">To take care of</p></td></tr><tr><td style=\"padding:8px 30px 26px;\">{{#each todos}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:10px;\"><tr><td style=\"width:4px;background:#d946ef;border-radius:4px 0 0 4px;\"></td><td style=\"padding:12px 16px;background:#f8fafc;border:1px solid #eef2f7;border-left:none;border-radius:0 10px 10px 0;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><div style=\"font-size:15px;font-weight:600;color:#1c1917;\">{{icon}} {{task}}</div>{{#if dueLabel}}<div style=\"margin-top:3px;font-size:12px;color:#a8a29e;\">due {{dueLabel}}</div>{{/if}}</td><td align=\"right\" style=\"vertical-align:top;white-space:nowrap;\"><span style=\"display:inline-block;background:{{categoryBg}};color:{{categoryText}};font-size:11px;font-weight:600;padding:3px 9px;border-radius:999px;\">{{categoryLabel}}</span></td></tr></table></td></tr></table>{{/each}}{{#unless todos}}<p style=\"margin:2px 0 0;font-size:14px;color:#a8a29e;\">Inbox zero on tasks. ✅</p>{{/unless}}</td></tr><tr><td style=\"padding:16px 30px;background:#faf9f7;border-top:1px solid #f0ede7;text-align:center;\"><p style=\"margin:0;font-size:12px;color:#a8a29e;\">That's your digest — make it a good one. 🚀</p></td></tr></table></td></tr></table></body></html>"
  }
}
