{
  "TemplateName": "remind-me-digest",
  "TemplateContent": {
    "Subject": "📮 Daily digest — {{subjectDate}}",
    "Html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>@media only screen and (max-width:600px){.op{padding:24px 18px !important;}.nt-h1{font-size:26px !important;}}</style></head><body style=\"margin:0;padding:0;background:#faf8f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" class=\"op\" style=\"padding:44px 20px;background:#faf8f4;\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"max-width:540px;\"><tr><td style=\"padding:0 4px 20px;border-bottom:2px solid #18181b;\"><p style=\"margin:0;font-size:12px;color:#a1a1aa;letter-spacing:1px;text-transform:uppercase;font-weight:600;\">{{today}}</p><h1 class=\"nt-h1\" style=\"margin:10px 0 0;font-size:30px;font-weight:700;color:#18181b;letter-spacing:-0.7px;line-height:1.1;\">早安，Good morning ☀️</h1></td></tr><tr><td style=\"padding:26px 4px 0;\"><p style=\"margin:0;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#b45309;border-left:3px solid #b45309;padding-left:9px;\">待办事项 · To do</p></td></tr><tr><td style=\"padding:6px 4px 0;\">{{#each todos}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-bottom:1px solid #eceae4;\"><tr><td style=\"width:20px;vertical-align:top;padding:11px 0;font-size:15px;color:#c4c0b6;\">○</td><td style=\"padding:11px 0 11px 6px;\"><div style=\"font-size:16px;font-weight:600;color:#18181b;line-height:1.4;\">{{icon}} {{task}}</div><div style=\"margin-top:4px;font-size:13px;color:#a1a1aa;\"><span style=\"color:{{categoryText}};font-weight:700;\">{{categoryLabel}}</span><span style=\"color:#d4d4d8;\"> · </span><span>{{statusLabel}}</span>{{#if dueLabel}}<span style=\"color:#d4d4d8;\"> · </span><span>due {{dueLabel}}</span>{{/if}}</div></td></tr></table>{{/each}}{{#unless todos}}<p style=\"margin:0;padding:11px 0;border-bottom:1px solid #eceae4;font-size:15px;color:#a1a1aa;\">所有任务已完成. ✅</p>{{/unless}}</td></tr><tr><td style=\"padding:24px 4px 0;\"><p style=\"margin:0;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#0369a1;border-left:3px solid #0369a1;padding-left:9px;\">接下来的日程 · Schedule</p></td></tr><tr><td style=\"padding:6px 4px 0;\">{{#each events}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-bottom:1px solid #eceae4;\"><tr><td style=\"width:78px;vertical-align:top;padding:11px 0;\"><div style=\"font-size:13px;font-weight:700;color:#0369a1;font-variant-numeric:tabular-nums;line-height:1.4;\">{{timeLabel}}</div></td><td style=\"padding:11px 0 11px 8px;\"><div style=\"font-size:16px;font-weight:600;color:#18181b;line-height:1.4;\">{{summary}}</div><div style=\"margin-top:3px;font-size:13px;color:#a1a1aa;\">{{dateLabel}}</div></td></tr></table>{{/each}}{{#unless events}}<p style=\"margin:0;padding:11px 0;border-bottom:1px solid #eceae4;font-size:15px;color:#a1a1aa;\">最近没有活动 — a clear, open day ahead. 🎉</p>{{/unless}}</td></tr><tr><td style=\"padding:24px 4px 0;\"><p style=\"margin:0;font-size:12px;color:#9ca3af;text-align:center;\">Take it one thing at a time. 元气满满 🚀</p></td></tr></table></td></tr></table></body></html>"
  }
}