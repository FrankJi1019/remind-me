{
  "TemplateName": "remind-me-timeline",
  "TemplateContent": {
    "Subject": "🗓️ Your day — {{subjectDate}}",
    "Html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head><body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:24px;background:#eef2f7;\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:640px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(15,23,42,0.08);\"><tr><td style=\"background:#0f172a;padding:22px 28px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><p style=\"margin:0;color:#94a3b8;font-size:12px;letter-spacing:1px;text-transform:uppercase;\">Good morning</p><h1 style=\"margin:4px 0 0;color:#ffffff;font-size:22px;font-weight:700;\">Here's your day</h1></td><td align=\"right\" style=\"vertical-align:middle;\"><span style=\"display:inline-block;background:#1e293b;color:#e2e8f0;font-size:12px;font-weight:600;padding:7px 14px;border-radius:999px;\">{{today}}</span></td></tr></table></td></tr><tr><td style=\"padding:26px 28px 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:middle;width:34px;\"><span style=\"display:inline-block;width:30px;height:30px;line-height:30px;text-align:center;background:#dbeafe;color:#1d4ed8;border-radius:8px;font-size:15px;\">📅</span></td><td style=\"padding-left:10px;font-size:15px;font-weight:700;color:#0f172a;letter-spacing:0.2px;\">Schedule</td></tr></table></td></tr><tr><td style=\"padding:12px 28px 4px;\">{{#each events}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"width:26px;vertical-align:top;\"><div style=\"width:11px;height:11px;border-radius:50%;background:#3b82f6;border:2px solid #bfdbfe;margin:5px auto 0;\"></div><div style=\"width:2px;height:100%;background:#e2e8f0;margin:2px auto 0;\"></div></td><td style=\"padding:0 0 14px 12px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border:1px solid #eef2f7;border-radius:12px;\"><tr><td style=\"padding:12px 16px;\"><div style=\"font-size:15px;font-weight:600;color:#0f172a;\">{{summary}}</div><div style=\"margin-top:4px;font-size:13px;color:#64748b;\">{{dateLabel}} · <span style=\"color:#2563eb;font-weight:600;\">{{timeLabel}}</span></div></td></tr></table></td></tr></table>{{/each}}{{#unless events}}<p style=\"margin:0 0 12px;font-size:14px;color:#94a3b8;padding-left:38px;\">Nothing scheduled — enjoy the free time 🎉</p>{{/unless}}</td></tr><tr><td style=\"padding:14px 28px 8px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:middle;width:34px;\"><span style=\"display:inline-block;width:30px;height:30px;line-height:30px;text-align:center;background:#fae8ff;color:#a21caf;border-radius:8px;font-size:15px;\">✓</span></td><td style=\"padding-left:10px;font-size:15px;font-weight:700;color:#0f172a;letter-spacing:0.2px;\">Tasks</td></tr></table></td></tr><tr><td style=\"padding:12px 28px 22px;\">{{#each todos}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"width:26px;vertical-align:top;\"><div style=\"width:11px;height:11px;border-radius:50%;background:#d946ef;border:2px solid #f5d0fe;margin:5px auto 0;\"></div><div style=\"width:2px;height:100%;background:#e2e8f0;margin:2px auto 0;\"></div></td><td style=\"padding:0 0 14px 12px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border:1px solid #eef2f7;border-radius:12px;\"><tr><td style=\"padding:12px 16px;\"><div style=\"font-size:15px;font-weight:600;color:#0f172a;\">{{icon}} {{task}}</div><div style=\"margin-top:6px;\"><span style=\"display:inline-block;background:{{categoryBg}};color:{{categoryText}};font-size:11px;font-weight:600;padding:3px 9px;border-radius:999px;margin-right:6px;\">{{categoryLabel}}</span><span style=\"display:inline-block;background:{{statusBg}};color:{{statusText}};font-size:11px;font-weight:600;padding:3px 9px;border-radius:999px;\">{{statusLabel}}</span>{{#if dueLabel}}<span style=\"font-size:12px;color:#94a3b8;\"> · {{dueLabel}}</span>{{/if}}</div></td></tr></table></td></tr></table>{{/each}}{{#unless todos}}<p style=\"margin:0;font-size:14px;color:#94a3b8;padding-left:38px;\">All tasks complete ✅</p>{{/unless}}</td></tr><tr><td style=\"padding:16px 28px;background:#f8fafc;border-top:1px solid #eef2f7;text-align:center;\"><p style=\"margin:0;font-size:12px;color:#94a3b8;\">One step at a time — you've got this 🚀</p></td></tr></table></td></tr></table></body></html>"
  }
}
