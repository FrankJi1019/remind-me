{
  "TemplateName": "remind-me-timeline",
  "TemplateContent": {
    "Subject": "🗓️ Your day — {{subjectDate}}",
    "Html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>@media only screen and (max-width:600px){.op{padding:16px 10px !important;}.pl-card{border-radius:8px !important;}.pl-pad{padding:0 22px !important;}.pl-head{padding:22px 22px 16px !important;}.pl-h1{font-size:24px !important;}.pl-gut{width:66px !important;}}</style></head><body style=\"margin:0;padding:0;background:#efe9df;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" class=\"op\" style=\"padding:28px 16px;background:#efe9df;\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" class=\"pl-card\" style=\"max-width:600px;background:#fffdf9;border-radius:10px;overflow:hidden;box-shadow:0 10px 34px rgba(60,50,30,0.12);border-top:5px solid #b45309;\"><tr><td class=\"pl-head\" style=\"padding:26px 30px 18px;\"><p style=\"margin:0;font-size:11px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:#b45309;\">Day Planner · 今日计划</p><h1 class=\"pl-h1\" style=\"margin:6px 0 0;font-size:27px;font-weight:800;color:#1c1917;letter-spacing:-0.4px;\">Good morning ☀️</h1><p style=\"margin:5px 0 0;font-size:13px;color:#8a817a;\">{{today}}</p></td></tr><tr><td class=\"pl-pad\" style=\"padding:0 30px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-top:2px solid #1c1917;\"><tr><td style=\"padding:14px 0 6px;\"><span style=\"font-size:12px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#1c1917;\">☑ Checklist</span> <span style=\"font-size:12px;color:#a8a29e;\">待办事项</span></td></tr></table></td></tr><tr><td class=\"pl-pad\" style=\"padding:0 30px;\">{{#each todos}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-top:1px solid #efe7d8;\"><tr><td style=\"width:24px;vertical-align:top;padding:9px 0;font-size:15px;color:#b45309;\">☐</td><td style=\"padding:9px 0 9px 8px;\"><div style=\"font-size:15px;font-weight:600;color:#1c1917;line-height:1.4;\">{{icon}} {{task}}</div><div style=\"margin-top:5px;\"><span style=\"display:inline-block;background:{{categoryBg}};color:{{categoryText}};font-size:11px;font-weight:600;padding:2px 9px;border-radius:999px;margin-right:5px;\">{{categoryLabel}}</span><span style=\"display:inline-block;background:{{statusBg}};color:{{statusText}};font-size:11px;font-weight:600;padding:2px 9px;border-radius:999px;\">{{statusLabel}}</span>{{#if dueLabel}}<span style=\"font-size:12px;color:#a8a29e;\"> · {{dueLabel}}</span>{{/if}}</div></td></tr></table>{{/each}}{{#unless todos}}<p style=\"margin:0;padding:9px 0;border-top:1px solid #efe7d8;font-size:14px;color:#a8a29e;\">所有任务已完成 ✅</p>{{/unless}}</td></tr><tr><td class=\"pl-pad\" style=\"padding:0 30px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-top:2px solid #1c1917;\"><tr><td style=\"padding:18px 0 6px;\"><span style=\"font-size:12px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#1c1917;\">◷ Agenda</span> <span style=\"font-size:12px;color:#a8a29e;\">接下来的日程</span></td></tr></table></td></tr><tr><td class=\"pl-pad\" style=\"padding:0 30px 4px;\">{{#each events}}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-top:1px solid #efe7d8;\"><tr><td class=\"pl-gut\" style=\"width:78px;vertical-align:top;padding:9px 0;\"><div style=\"font-size:13px;font-weight:700;color:#b45309;font-variant-numeric:tabular-nums;line-height:1.35;\">{{timeLabel}}</div></td><td style=\"padding:9px 0 9px 14px;border-left:2px solid #f0e6d2;\"><div style=\"font-size:15px;font-weight:600;color:#1c1917;line-height:1.4;\">{{summary}}</div><div style=\"margin-top:2px;font-size:12px;color:#a8a29e;\">{{dateLabel}}</div></td></tr></table>{{/each}}{{#unless events}}<p style=\"margin:0;padding:9px 0;border-top:1px solid #efe7d8;font-size:14px;color:#a8a29e;\">最近没有活动 — enjoy the free time 🎉</p>{{/unless}}</td></tr><tr><td class=\"pl-pad\" style=\"padding:24px 30px 26px;border-top:2px solid #1c1917;\"><p style=\"margin:0;font-size:12px;color:#9ca3af;text-align:center;\">Plan the day, then make it yours — 你可以的 🚀</p></td></tr></table></td></tr></table></body></html>"
  }
}